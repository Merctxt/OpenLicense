ASPNETCORE_ENVIRONMENT=Production

# API configuration
API_PORT=5000
DATABASE_CONNECTION=
JWT_SECRET_KEY=
JWT_ISSUER=OpenLicenseApi
JWT_AUDIENCE=OpenLicenseApiUsers
REGISTRATION_ENABLED=true

# Email / SMTP configuration
Email__Host=
Email__Port=587
Email__Secure=false
Email__Username=
Email__Password=
Email__From=

# Report settings
ReportSettings__IntervalMinutes=4320
ReportSettings__ExpiryWarningDays=7
ReportSettings__Enabled=true

# Frontend configuration
FRONTEND_PORT=3000
VITE_API_URL=
VITE_STATUS_URL=
VITE_SOURCE_URL=
VITE_REGISTRATION_ENABLED=true

# OpenTelemetry / OpenObserve
OTEL_EXPORTER_OTLP_ENDPOINT=https://.../api/default
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64user:password>
