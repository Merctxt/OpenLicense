ASPNETCORE_ENVIRONMENT=Development

# Backend configurations
API_PORT=5000
DATABASE_CONNECTION=Host=YOUR_DATABASE_HOST;Port=1489;Database=postgres;Username=postgres;Password=YOUR_DATABASE_PASSWORD
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ISSUER=OpenLicenseApi
JWT_AUDIENCE=OpenLicenseApiUsers

# Email (SMTP) Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_name <your_email@gmail.com>


# Frontend configurations
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000
VITE_STATUS_URL=YOUR_STATUS_URL
VITE_SOURCE_URL=YOUR_SOURCE_URL